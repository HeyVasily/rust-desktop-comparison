# Retain the original LF/CRLF bytes of native measurement exports.
measurements/** -text whitespace=cr-at-eol,-blank-at-eof
# Preserve empty package-version fields in these original environment exports.
measurements/gtk-memory-ab-2026-11-08/**/build/environment.txt -text whitespace=cr-at-eol,-blank-at-eof,-blank-at-eol

# Keep generated evidence available without obscuring authored changes in PR review.
measurements/native-*/** linguist-generated=true
measurements/desktop-integrated-*/*.csv linguist-generated=true
measurements/desktop-integrated-*/*.json linguist-generated=true
measurements/desktop-integrated-*/SHA256SUMS linguist-generated=true
data/desktop-results.json linguist-generated=true
